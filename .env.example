[TEMPLATE]
# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ── Stellar Testnet Reward System ────────────────────────────────────────
# These env vars must be set in the Convex dashboard (for deployed functions)
# OR in .env.local for local development with `npx convex dev`.

# AES-256 encryption key for encrypting Stellar secret keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STELLAR_KEY_ENCRYPTION_SECRET=

# Issuing account — creates the ROTR asset (funded once via Friendbot)
# Generate: stellar keys generate --network testnet issuing
# Fund: stellar keys fund issuing --network testnet
STELLAR_ISSUING_SECRET=

# Distribution account — holds ROTR and sends rewards to users
# Generate: stellar keys generate --network testnet distribution
# Fund: stellar keys fund distribution --network testnet
STELLAR_DISTRIBUTION_SECRET=
